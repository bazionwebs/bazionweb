#!/bin/sh
# ─────────────────────────────────────────────────────────────────────────────
# BazionWeb pre-commit secret scan — last line of defense before a commit
# leaves your machine.
#
# Behaviour:
#   1. If gitleaks is installed (https://github.com/gitleaks/gitleaks), run the
#      full rule set (defaults + .gitleaks.toml) on staged changes.
#   2. Otherwise fall back to a zero-dependency pattern scan that catches
#      Paystack sk_/pk_ keys and Resend keys accidentally staged.
#
# Install on another machine (no git config needed):
#   cp scripts/hooks/pre-commit .git/hooks/pre-commit    # Git-for-Windows runs
#                                                        # hooks in bundled sh
#   chmod +x .git/hooks/pre-commit                       # not needed on Windows
# ─────────────────────────────────────────────────────────────────────────────

if command -v gitleaks >/dev/null 2>&1; then
  exec gitleaks protect --staged --redact -v
fi

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

leak=0
for f in $staged; do
  [ -f "$f" ] || continue
  # -I: skip binary-ish files; -n: show the offending line for fast triage
  if grep -nI -E 'sk_(live|test)_[0-9a-f]{32}|pk_live_[0-9a-f]{32}|re_[A-Za-z0-9_]{20,}' -- "$f" 1>&2; then
    echo "BLOCKED: potential secret(s) in $f — rotate + keep secrets in the Render dashboard, not in files." >&2
    leak=1
  fi
done

exit $leak
