# Git and repo files
.git
.github
*.md
LICENSE
.editorconfig
.gitattributes

# Environment files
.env
.env.local
.env.*.local

# Build artifacts
dist/
build/
.next/
out/

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test and coverage
coverage/
.nyc_output/
playwright-report/
test-results/

# Binaries and local downloads
*.exe
*.zip
*.tar.gz
*.docx
*.pdf
*.xlsx
download*.json

# Keep app-local environment files out of every Docker build context.
**/.env
**/.env.*

# Exclude workspace-local dependencies and generated artifacts from root-context builds.
**/node_modules/
**/coverage/
**/dist/
**/build/
**/.next/
**/.nyc_output/
**/playwright-report/
**/test-results/
