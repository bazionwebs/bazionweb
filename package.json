{
  "name": "bazionweb-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n \"API,WEB\" -c \"magenta,blue\" \"npm --workspace=@bazionweb/api run dev\" \"npm --workspace=@bazionweb/web run dev\"",
    "dev:api": "npm --workspace=@bazionweb/api run dev",
    "dev:web": "npm --workspace=@bazionweb/web run dev",
    "build": "npm run prisma:generate && npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "db:up": "docker compose -f infrastructure/docker/docker-compose.dev.yml up -d db",
    "db:down": "docker compose -f infrastructure/docker/docker-compose.dev.yml down",
    "prisma:generate": "npx --yes prisma generate --schema=prisma/schema.prisma",
    "prisma:push": "npx --yes prisma db push --schema=prisma/schema.prisma",
    "prisma:seed": "npm --workspace=@bazionweb/api run prisma:seed",
    "admin:create": "node scripts/create-superadmin.js",
    "test:e2e": "node --no-warnings --experimental-strip-types scripts/run-e2e-audit-suite.ts",
    "verify:feature14": "npm --workspace=@bazionweb/api run verify:feature14"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@prisma/client": "7.10.1",
    "jsonwebtoken": "^9.0.3",
    "prisma": "5.22.0"
  },
  "overrides": {
    "postcss": "8.5.31",
    "multer": "2.5.0",
    "qs": "6.16.1",
    "body-parser": "1.20.9",
    "js-yaml": "4.3.2",
    "lodash": "4.18.1",
    "follow-redirects": "1.16.3",
    "picomatch": "4.0.7",
    "tmp": "0.2.7",
    "glob": "14.0.4",
    "@nestjs/swagger": {
      "js-yaml": "4.3.2",
      "lodash": "4.18.1"
    },
    "@nestjs/config": {
      "lodash": "4.18.1"
    },
    "@angular-devkit/core": {
      "picomatch": "4.0.7"
    },
    "external-editor": {
      "tmp": "0.2.7"
    },
    "inquirer": {
      "tmp": "0.2.7"
    }
  }
}
