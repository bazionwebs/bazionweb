# ─────────────────────────────────────────────────────────────────────────────
# BazionWeb — Environment Variables Reference
# Aligned with: MPD v2.0, Section 10.3 (Secrets & Environment Management)
#
# RULES:
#   1. NEVER commit a real .env file — only .env.example
#   2. Production secrets live in GitHub Actions Secrets (CI) +
#      Docker Swarm Secrets or HashiCorp Vault (runtime)
#   3. All values here are PLACEHOLDERS — replace before use
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
IMAGE_TAG=latest

# ── Database (PostgreSQL 16) ──────────────────────────────────────────────────
DB_NAME=bazionweb
DB_USER=bazionweb
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32CHARS
DATABASE_URL=postgresql://bazionweb:CHANGE_ME@db:5432/bazionweb?schema=public
# Production uses Neon: DATABASE_URL = Neon pooled ("-pooler") string for
# runtime queries; DATABASE_URL_UNPOOLED = Neon direct string (used by Prisma
# `directUrl` for `prisma migrate`). For local Docker Postgres set both to the
# same value. DB_NAME/DB_USER/DB_PASSWORD only apply to the local dev compose.
DATABASE_URL_UNPOOLED=postgresql://bazionweb:CHANGE_ME@db:5432/bazionweb?schema=public

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_256BIT_RANDOM_HEX_STRING
# Document signatures use a dedicated stable secret when configured, otherwise a
# domain-separated key derived from JWT_SECRET. Keep the previous key during rotation.
# Generate with a secret manager; never commit a real value.
# DOCUMENT_SIGNING_SECRET=CHANGE_ME_256BIT_RANDOM_HEX_STRING
# DOCUMENT_SIGNING_PREVIOUS_SECRET=
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Auth provider ─────────────────────────────────────────────────────────────
# local = built-in email+password auth (default, no extra infra).
# keycloak = external Keycloak (also set KEYCLOAK_URL/REALM/CLIENT_ID/SECRET).
AUTH_PROVIDER=local
# Sets admin@bazionweb.com password when seeding. Never commit a real value.
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD_16CHARS

# ── Keycloak ─────────────────────────────────────────────────────────────────
KEYCLOAK_URL=https://auth.bazionweb.com
KEYCLOAK_REALM=bazionweb
KEYCLOAK_CLIENT_ID=bazionweb-api
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_KEYCLOAK_CLIENT_SECRET
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN_PASSWORD

# ── Strapi CMS ────────────────────────────────────────────────────────────────
STRAPI_APP_KEYS=CHANGE_ME_KEY1,CHANGE_ME_KEY2,CHANGE_ME_KEY3,CHANGE_ME_KEY4
STRAPI_API_TOKEN_SALT=CHANGE_ME_TOKEN_SALT
STRAPI_ADMIN_JWT_SECRET=CHANGE_ME_ADMIN_JWT
STRAPI_JWT_SECRET=CHANGE_ME_JWT_SECRET
NEXT_PUBLIC_STRAPI_API_URL=https://cms.bazionweb.com

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://bazionweb.com
# Optional — public origin of the Bazion Platform tenant workspace console for portal deep links
# NEXT_PUBLIC_PLATFORM_APP_URL=https://platform.bazionweb.com
# Optional — the API is same-origin (/api/v1 routed by Traefik on Dokploy).
# Only set this when pointing the web app at an external API host.
# NEXT_PUBLIC_API_URL=https://bazionweb.com/api/v1
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_POSTHOG_KEY=phc_CHANGE_ME

# Microsoft Clarity Analytics & Heatmaps
# Project ID obtained from clarity.microsoft.com. If omitted, Clarity is disabled.
NEXT_PUBLIC_CLARITY_PROJECT_ID=CHANGE_ME_CLARITY_PROJECT_ID

# Tawk.to Live Chat & Help Center Widget
# Property and Widget identifiers from dashboard.tawk.to (Defaults match BazionWeb live widget)
NEXT_PUBLIC_TAWK_PROPERTY_ID=6ae6de21896a4b3c3630071b
NEXT_PUBLIC_TAWK_WIDGET_ID=1k6at7dq5
# Help Center link used in the footer & emails. Defaults to /faq.
# Only set this to https://help.bazionweb.com AFTER the Cloudflare CNAME
# for "help" exists and the Tawk.to Knowledge Base custom domain is verified.
NEXT_PUBLIC_HELP_CENTER_URL=/faq

# ── WhatsApp Click-to-Chat ────────────────────────────────────────────────────
# Business number in full international format, digits only (no +, spaces, or
# leading zero). Every WhatsApp CTA across the public site and client portal
# reads this single source of truth.
NEXT_PUBLIC_WHATSAPP_NUMBER=254721287053
NEXT_PUBLIC_WHATSAPP_DISPLAY="+254 721 287 053"

# ── Email (Resend & SMTP) ─────────────────────────────────────────────────────
# Primary transactional email delivery via Resend HTTP API (https://resend.com)
# Set RESEND_API_KEY (or SMTP_*) on bazionweb-api and/or bazionweb-web.
RESEND_API_KEY=CHANGE_ME_RESEND_API_KEY
# Optional shared BFF-to-API token handoff secret (falls back to PAYSTACK_SECRET_KEY or JWT_SECRET)
INTERNAL_DISPATCH_SECRET=CHANGE_ME_RANDOM_32CHAR_DISPATCH_SECRET
# Internal team notification recipient for /contact and /quote lead ingestion
LEADS_NOTIFICATION_EMAIL=hello@bazionweb.com

# SMTP Fallback (Nodemailer) — used if Resend API key is omitted or delivery fails
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=CHANGE_ME_RESEND_API_KEY
SMTP_FROM=noreply@bazionweb.com
SUPPORT_EMAIL=support@bazionweb.com
ALERTS_EMAIL=alerts@bazionweb.com

# ── Payments & Billing (split rail: IntaSend M-Pesa + Paystack cards, Wise payouts only)
# IntaSend = M-Pesa STK (KES). Paystack = cards (KES/USD). Wise = payouts + invoice links only.
# Paystack is server-side in the API — no NEXT_PUBLIC secret needed.
FRONTEND_URL=https://bazionweb.com
PAYSTACK_SECRET_KEY=sk_test_CHANGE_ME_PAYSTACK_SECRET_KEY
PAYSTACK_WEBHOOK_SECRET=sk_test_CHANGE_ME_PAYSTACK_WEBHOOK_SECRET
# Set to KES when your Paystack account settles in KES only (no USD domiciliary account yet).
# Even if left unset, the API automatically converts USD card checkouts to KES if Paystack
# returns "Currency not supported by merchant".
PAYSTACK_SETTLEMENT_CURRENCY=KES
# Optional override for USD -> KES card settlement conversion (defaults to DB Currency.exchangeRateToBase or 129.5)
# PAYSTACK_USD_KES_RATE=129.5

INTASEND_ENVIRONMENT=sandbox
INTASEND_PUBLISHABLE_KEY=ISPubKey_sandbox_CHANGE_ME
INTASEND_SECRET_KEY=ISSecretKey_sandbox_CHANGE_ME
WISE_ENVIRONMENT=sandbox
WISE_API_TOKEN=CHANGE_ME_WISE_API_TOKEN
WISE_PROFILE_ID=1001001
WISE_WEBHOOK_SECRET=CHANGE_ME_WISE_WEBHOOK_SECRET

# Corporate Tax & Direct Settlement (Co-operative Bank of Kenya & Lipa Na M-Pesa Paybill)
COMPANY_KRA_PIN=A006926734I
MPESA_PAYBILL_NUMBER=400200
MPESA_PAYBILL_ACCOUNT=1205232
BANK_BENEFICIARY="BAZION WEB"
BANK_ACCOUNT_NUMBER=01103361465001
BANK_IBAN=CHANGE_ME_IBAN
BANK_SWIFT_BIC=KCOOKENA
BANK_ADDRESS_LINE="Co-operative Bank of Kenya - Dandora Branch"
BANK_ADDRESS_CITY=Nairobi
BANK_ADDRESS_COUNTRY=Kenya

# ── Object Storage (Backblaze B2 / S3-compatible) ────────────────────────────
BACKBLAZE_BUCKET=bazionweb-backups
BACKBLAZE_REGION=us-west-004
BACKBLAZE_ENDPOINT=https://s3.us-west-004.backblazeb2.com
BACKBLAZE_KEY_ID=CHANGE_ME_BACKBLAZE_KEY_ID
BACKBLAZE_APP_KEY=CHANGE_ME_BACKBLAZE_APP_KEY

# ── Zammad (Support Ticketing) ────────────────────────────────────────────────
# Pinned official Zammad image (ghcr.io/zammad/zammad). Bump for upgrades.
ZAMMAD_VERSION=7.2.2-0012
# Dedicated Zammad database in the shared PostgreSQL instance —
# auto-created on first start (POSTGRESQL_DB_CREATE).
ZAMMAD_DB_NAME=zammad_production
# Elasticsearch JVM heap. Lower to -Xms512m -Xmx512m on a 2–4 GB VPS.
ELASTICSEARCH_JAVA_OPTS=-Xms1g -Xmx1g

# ── Cloudflare ────────────────────────────────────────────────────────────────
CLOUDFLARE_ZONE_ID=CHANGE_ME_ZONE_ID
CLOUDFLARE_API_TOKEN=CHANGE_ME_CF_API_TOKEN

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
RATE_LIMIT_QUOTE_MAX=10

# ── Sentry (Error Tracking) ───────────────────────────────────────────────────
SENTRY_DSN=https://CHANGE_ME@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_DSN=https://CHANGE_ME@o0.ingest.sentry.io/0

# ── Feature Flags ─────────────────────────────────────────────────────────────
FEATURE_QUOTE_CALCULATOR=true
FEATURE_CONSULTATION_BOOKING=false
FEATURE_CLIENT_HEALTH_SCORE=false

# ── Bazion Platform Provisioning Synchronization (Phase 3) ────────────────────
# PLATFORM_API_BASE_URL=https://platform-api.bazionweb.com
# PLATFORM_PROVISIONING_COMMAND_SECRET=CHANGE_ME_32CHAR_COMMAND_SECRET
# PLATFORM_PROVISIONING_COMMAND_ISSUER=bazionweb
# PLATFORM_PROVISIONING_COMMAND_AUDIENCE=bazion-platform:commercial-provisioning
# PLATFORM_CALLBACK_SIGNING_SECRET=CHANGE_ME_32CHAR_CALLBACK_SECRET
# PLATFORM_CALLBACK_BEARER_SECRET=
# PLATFORM_CALLBACK_MAX_SKEW_SECONDS=300
# PLATFORM_PROVISIONING_WORKER_ENABLED=false
# PLATFORM_PROVISIONING_BATCH_SIZE=10
# PLATFORM_PROVISIONING_LEASE_SECONDS=120
# PLATFORM_PROVISIONING_TIMEOUT_MS=5000

# ── Bazion Platform OIDC BFF Relying Party (Phase 5) ────────────────────────
# OIDC_ISSUER=https://platform-api.bazionweb.com
# Optional internal URL override when running OIDC token/JWKS backchannel calls inside Docker/Swarm
# OIDC_API_INTERNAL_URL=
# OIDC_CLIENT_ID=bazion-bff-platform
# OIDC_CLIENT_SECRET=CHANGE_ME_32CHAR_OIDC_CLIENT_SECRET
# OIDC_BFF_SESSION_SECRET=CHANGE_ME_32CHAR_OIDC_BFF_SESSION_SECRET
# (Set NEXT_PUBLIC_PLATFORM_APP_URL under Frontend above for portal deep-link buttons.)
