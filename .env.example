# ─────────────────────────────────────────────────────────────────────────────
# BazionWeb — Environment Variables Reference
# Aligned with: MPD v2.0, Section 10.3 (Secrets & Environment Management)
#
# RULES:
#   1. NEVER commit a real .env file — only .env.example
#   2. Production secrets live in GitHub Actions Secrets (CI) +
#      Docker Swarm Secrets or HashiCorp Vault (runtime)
#   3. All values here are PLACEHOLDERS — replace before use
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
IMAGE_TAG=latest

# ── Database (PostgreSQL 16) ──────────────────────────────────────────────────
DB_NAME=bazionweb
DB_USER=bazionweb
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32CHARS
DATABASE_URL=postgresql://bazionweb:CHANGE_ME@db:5432/bazionweb?schema=public
# Direct (non-pooled) URL for `prisma migrate`. Required when DATABASE_URL
# goes through a pooler (Neon PgBouncer "-pooler" host). Paste Neon's direct
# string here; leave unset for local Docker / Render Postgres (falls back to
# DATABASE_URL).
DATABASE_URL_UNPOOLED=postgresql://bazionweb:CHANGE_ME@db:5432/bazionweb?schema=public

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_256BIT_RANDOM_HEX_STRING
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Auth provider ─────────────────────────────────────────────────────────────
# local = built-in email+password auth (default, no extra infra).
# keycloak = external Keycloak (also set KEYCLOAK_URL/REALM/CLIENT_ID/SECRET).
AUTH_PROVIDER=local
# Sets admin@bazionweb.com password when seeding. Never commit a real value.
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD_16CHARS

# ── Keycloak ─────────────────────────────────────────────────────────────────
KEYCLOAK_URL=https://auth.bazionweb.com
KEYCLOAK_REALM=bazionweb
KEYCLOAK_CLIENT_ID=bazionweb-api
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_KEYCLOAK_CLIENT_SECRET
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN_PASSWORD

# ── Strapi CMS ────────────────────────────────────────────────────────────────
STRAPI_APP_KEYS=CHANGE_ME_KEY1,CHANGE_ME_KEY2,CHANGE_ME_KEY3,CHANGE_ME_KEY4
STRAPI_API_TOKEN_SALT=CHANGE_ME_TOKEN_SALT
STRAPI_ADMIN_JWT_SECRET=CHANGE_ME_ADMIN_JWT
STRAPI_JWT_SECRET=CHANGE_ME_JWT_SECRET
NEXT_PUBLIC_STRAPI_API_URL=https://cms.bazionweb.com

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://bazionweb.com
# Optional — the API is same-origin on Vercel (/api/v1 via service rewrite).
# Only set this when pointing the web app at an external API host.
# NEXT_PUBLIC_API_URL=https://bazionweb.com/api/v1
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_POSTHOG_KEY=phc_CHANGE_ME

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=CHANGE_ME_RESEND_API_KEY
SMTP_FROM=noreply@bazionweb.com
SUPPORT_EMAIL=support@bazionweb.com
ALERTS_EMAIL=alerts@bazionweb.com

# ── Payments & Billing (split rail: IntaSend M-Pesa + Paystack cards, Wise payouts only)
# IntaSend = M-Pesa STK (KES). Paystack = cards (KES/USD). Wise = payouts + invoice links only.
# Paystack is server-side in the API — no NEXT_PUBLIC secret needed.
FRONTEND_URL=https://bazionweb.com
PAYSTACK_SECRET_KEY=sk_test_CHANGE_ME_PAYSTACK_SECRET_KEY
PAYSTACK_WEBHOOK_SECRET=sk_test_CHANGE_ME_PAYSTACK_WEBHOOK_SECRET

INTASEND_ENVIRONMENT=sandbox
INTASEND_PUBLISHABLE_KEY=ISPubKey_sandbox_CHANGE_ME
INTASEND_SECRET_KEY=ISSecretKey_sandbox_CHANGE_ME
WISE_ENVIRONMENT=sandbox
WISE_API_TOKEN=CHANGE_ME_WISE_API_TOKEN
WISE_PROFILE_ID=1001001
WISE_WEBHOOK_SECRET=CHANGE_ME_WISE_WEBHOOK_SECRET

# Manual B2B settlement (Wise virtual receiving unavailable for KE businesses)
BANK_BENEFICIARY=BazionWeb Technologies Ltd
BANK_ACCOUNT_NUMBER=CHANGE_ME_BANK_ACCOUNT
BANK_IBAN=CHANGE_ME_IBAN
BANK_SWIFT_BIC=CHANGE_ME_SWIFT
BANK_ADDRESS_LINE=CHANGE_ME_ADDRESS_LINE
BANK_ADDRESS_CITY=Nairobi
BANK_ADDRESS_COUNTRY=Kenya

# ── Object Storage (Backblaze B2 / S3-compatible) ────────────────────────────
BACKBLAZE_BUCKET=bazionweb-backups
BACKBLAZE_REGION=us-west-004
BACKBLAZE_ENDPOINT=https://s3.us-west-004.backblazeb2.com
BACKBLAZE_KEY_ID=CHANGE_ME_BACKBLAZE_KEY_ID
BACKBLAZE_APP_KEY=CHANGE_ME_BACKBLAZE_APP_KEY

# ── Zammad (Support Ticketing) ────────────────────────────────────────────────
# Pinned official Zammad image (ghcr.io/zammad/zammad). Bump for upgrades.
ZAMMAD_VERSION=7.2.2-0012
# Dedicated Zammad database in the shared PostgreSQL instance —
# auto-created on first start (POSTGRESQL_DB_CREATE).
ZAMMAD_DB_NAME=zammad_production
# Elasticsearch JVM heap. Lower to -Xms512m -Xmx512m on a 2–4 GB VPS.
ELASTICSEARCH_JAVA_OPTS=-Xms1g -Xmx1g

# ── Cloudflare ────────────────────────────────────────────────────────────────
CLOUDFLARE_ZONE_ID=CHANGE_ME_ZONE_ID
CLOUDFLARE_API_TOKEN=CHANGE_ME_CF_API_TOKEN

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
RATE_LIMIT_QUOTE_MAX=10

# ── Sentry (Error Tracking) ───────────────────────────────────────────────────
SENTRY_DSN=https://CHANGE_ME@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_DSN=https://CHANGE_ME@o0.ingest.sentry.io/0

# ── Feature Flags ─────────────────────────────────────────────────────────────
FEATURE_QUOTE_CALCULATOR=true
FEATURE_CONSULTATION_BOOKING=false
FEATURE_CLIENT_HEALTH_SCORE=false
