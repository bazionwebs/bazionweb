{
  "name": "@bazionweb/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "prebuild": "npx --yes prisma generate --schema=prisma/schema.prisma",
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "test": "jest",
    "test:cov": "jest --coverage",
    "tsc": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "prisma:generate": "npx --yes prisma generate --schema=prisma/schema.prisma",
    "prisma:seed": "prisma db seed --schema=prisma/schema.prisma",
    "prisma:migrate": "npx --yes prisma migrate deploy --schema=prisma/schema.prisma",
    "verify:feature14": "ts-node scripts/verify-troubleshooting-proactive.ts"
  },
  "dependencies": {
    "@nestjs/axios": "^3.0.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/event-emitter": "^2.0.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/schedule": "^4.0.0",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^10.2.0",
    "@nestjs/throttler": "^5.1.0",
    "@prisma/client": "5.22.0",
    "axios": "^1.20.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^7.1.0",
    "joi": "^18.3.2",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "nodemailer": "^10.1.7",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.22",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "prisma": "5.22.0",
    "reflect-metadata": "^0.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  },
  "prisma": {
    "seed": "ts-node --transpile-only ../../prisma/seed.ts"
  },
  "overrides": {
    "multer": "2.5.0",
    "qs": "6.16.1",
    "body-parser": "1.20.9",
    "js-yaml": "4.3.2",
    "lodash": "4.18.1",
    "follow-redirects": "1.16.3",
    "picomatch": "4.0.7",
    "tmp": "0.2.7",
    "glob": "14.0.4",
    "@nestjs/swagger": {
      "js-yaml": "4.3.2",
      "lodash": "4.18.1"
    },
    "@nestjs/config": {
      "lodash": "4.18.1"
    },
    "@angular-devkit/core": {
      "picomatch": "4.0.7"
    },
    "external-editor": {
      "tmp": "0.2.7"
    },
    "inquirer": {
      "tmp": "0.2.7"
    }
